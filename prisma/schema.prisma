// Prisma schema for BrainBerry therapeutic game molds
// Using SQLite locally; switch provider in production (e.g., postgres, mongodb).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // Change to "postgresql" or "mongodb" for production
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // hashed password
  name      String
  role      String   // "THERAPIST", "PARENT", "RESEARCHER"
  phone     String?
  license   String?
  organization String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  children  ChildProfile[]
}

model ChildProfile {
  id        String   @id @default(cuid())
  name      String
  age       Int
  diagnosis String // ASD, ADHD, HYBRID or other text
  notes     String?
  accessCode String @unique // 6-digit code for child login
  userId    String  // parent/therapist who manages this child
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  assignments MoldAssignment[]
  sessions   GameSession[]
}

model GameMold {
  id          String   @id @default(cuid())
  name        String
  category    String
  structureType String
  experienceType String
  primaryObjective String
  rules       String
  lockStructure Boolean @default(false)
  allowThemes  Boolean @default(true)
  allowPacing  Boolean @default(true)
  allowRewards Boolean @default(true)
  allowAvatars Boolean @default(true)
  customizationNotes String?  
  ageMin      Int
  ageMax      Int
  difficulty  String
  learnerProfiles String // CSV
  executiveFunctionTargets String? // CSV
  sensoryPreferences String? // CSV
  skillTargets String? // CSV
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scenes      Scene[]
  assignments MoldAssignment[]
  sessions    GameSession[]
}

model Scene {
  id        String   @id @default(cuid())
  index     Int      // order in flow
  title     String
  narrative String?
  instructions String
  pacingCalm Boolean @default(false)
  pacingFast Boolean @default(false)
  reinforcement String?
  moldId    String
  mold      GameMold @relation(fields: [moldId], references: [id], onDelete: Cascade)
  assets    Asset[]
}

model Asset {
  id     String @id @default(cuid())
  type   String
  label  String
  url    String
  sceneId String
  scene  Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)
}

model MoldAssignment {
  id        String   @id @default(cuid())
  moldId    String
  childId   String
  status    String   @default("assigned") // assigned, in-progress, completed
  progress  Int      @default(0) // percent
  lastInteraction DateTime? 
  createdAt DateTime @default(now())
  mold      GameMold @relation(fields: [moldId], references: [id], onDelete: Cascade)
  child     ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  sessions  GameSession[]
}

model GameSession {
  id          String   @id @default(cuid())
  childId     String
  moldId      String
  assignmentId String? // optional link to assignment
  durationSec Int      @default(0)
  completionPercent Int @default(0)
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  mode        String? // calm | fast | other pacing
  notes       String?
  skillMetrics Json?   // JSON blob of skill improvements, etc.
  child       ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  mold        GameMold @relation(fields: [moldId], references: [id], onDelete: Cascade)
  assignment  MoldAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  @@index([childId])
  @@index([moldId])
  @@index([assignmentId])
  @@index([startedAt])
}
