# Supabase local development settings
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Production settings (replace with your actual Supabase project values)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Image Generation
GEMINI_API_KEY=your-gemini-api-key-here
# Add Google Cloud TTS API Key for premium audio (optional)
GOOGLE_CLOUD_TTS_API_KEY=your-google-cloud-tts-key-here
